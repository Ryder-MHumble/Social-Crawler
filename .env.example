# Redis Configuration
REDIS_DB_HOST=127.0.0.1
REDIS_DB_PWD=123456
REDIS_DB_PORT=6379
REDIS_DB_NUM=0

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_key

# Proxy Configuration (Wandou HTTP)
# your_wandou_http_app_key
WANDOU_APP_KEY=

# Proxy Configuration (Kuaidaili)
# your_kuaidaili_secret_id
KDL_SECERT_ID=
# your_kuaidaili_signature
KDL_SIGNATURE=
# your_kuaidaili_username
KDL_USER_NAME=
# your_kuaidaili_password
KDL_USER_PWD=

# Proxy Configuration (Jisu HTTP)
# Get JiSu HTTP IP extraction key value
jisu_key=
# Get JiSu HTTP IP extraction encryption signature
jisu_crypto=

# Remote CDP (optional)
# If set, Social-Crawler will connect to this remote browser instead of launching
# a local Chrome. The token may be embedded in the URL (query string) or passed
# via CDP_REMOTE_HEADERS in config/base_config.py.
# Example: wss://browser.example.com/ws/sessions/<id>/cdp/devtools/browser/<browser-id>?token=...
CDP_REMOTE_WS_URL=

# Browsermint integration (task center -> Browsermint backend)
# Browsermint remains the browser/session system. Social-Crawler only calls
# Browsermint's internal integration API at run start to fetch a fresh CDP URL.
BROWSERMINT_BASE_URL=http://127.0.0.1:24710
BROWSERMINT_INTEGRATION_API_KEY=
# Optional request timeout in seconds for Browsermint integration calls.
BROWSERMINT_TIMEOUT_SEC=15

# Sentiment monitor relevance filter (optional, per-run env fallback)
SENTIMENT_ENABLE_RELEVANCE_FILTER=true
SENTIMENT_RELEVANCE_MUST_CONTAIN=北京中关村学院,中关村学院,中关村人工智能研究院
SENTIMENT_RELEVANCE_EXCLUDE_KEYWORDS=

# Global relevance filter defaults (base_config.py)
ENABLE_RELEVANCE_FILTER=true
RELEVANCE_MUST_CONTAIN=北京中关村学院,中关村学院,中关村人工智能研究院
RELEVANCE_EXCLUDE_KEYWORDS=
RELEVANCE_MATCH_MODE=loose
RELEVANCE_MIN_MATCH_CHARS=3
RELEVANCE_MIN_MATCH_RATIO=0.30
